# ─────────────────────────────────────────────
#  ShopWave ERP — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ─────────────────────────────────────────────

# Django
SECRET_KEY=django-insecure-change-this-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# Base de données PostgreSQL
DB_NAME=shopwave_erp
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (optionnel en développement — console backend par défaut)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@shopwave.com

# Stripe (optionnel en développement)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend
VITE_API_URL=http://localhost:8000
